rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Resume PDFs (Module 10): owner-only write. Type (PDF) + size (<=5MB) are
    // validated client-side before upload; the resource-metadata checks were
    // removed because they intermittently reject resumable uploads at the
    // beginResumableUpload step (403).
    match /resumes/{userId}/{fileName} {
      allow write:  if request.auth != null && request.auth.uid == userId;
      allow read:   if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Profile photos: owner-only write. Publicly readable.
    match /profilePhotos/{userId}/{fileName} {
      allow write:  if request.auth != null && request.auth.uid == userId;
      allow read:   if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Certificates: on-device PDF uploaded by its owner; public read (shareable).
    match /certificates/{userId}/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
