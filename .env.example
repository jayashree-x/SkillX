# Copy to functions/.env for local emulator use, and set the same values in
# production with:  firebase functions:secrets:set <NAME>
# NEVER commit real secret values.

# Gmail SMTP (meeting-link emails via nodemailer). Requires 2-Step Verification
# on the account + a 16-char App Password (NOT your normal password).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Anthropic Claude API (AI quiz generation). Set a spend cap in the console.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
